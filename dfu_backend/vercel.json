{
  "version": 2,
  "buildCommand": "pip install --upgrade pip && pip install -r requirements-vercel.txt --no-cache-dir",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
